# /etc/frr/daemons -- fleetnode VPN concentrator (Debian 12 Bookworm)
#
# Only bgpd is enabled.  zebra is always started by the frr init script
# when any routing daemon is active; it does not need to be listed here.
#
# BGP neighbour config (AS 65001 -> AS 65002) is in /etc/frr/frr.conf
# (Build Order step 4 complete).
#
# FRR service is installed but DISABLED in the AMI (systemctl disable frr).
# Enable it manually when Return GW (Build Order step 7) is ready for
# T3 testing (ipsecnode BGP integration, Increment 6c).

bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

#
# Daemon options
#
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
