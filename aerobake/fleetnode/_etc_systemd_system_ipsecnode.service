[Unit]
Description=IPSec VPN node lifecycle daemon
Documentation=https://github.com/michaelrommel/fleetsuite
After=network-online.target strongswan.service frr.service vpp.service
Wants=network-online.target

[Service]
Environment="RUST_LOG=ipsecnode=debug"
Type=simple
ExecStart=/usr/local/bin/ipsecnode
Restart=on-failure
RestartSec=10s
# ipsecnode writes structured logs to stdout; systemd-journald captures them.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipsecnode

[Install]
WantedBy=multi-user.target
