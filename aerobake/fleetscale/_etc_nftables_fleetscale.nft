#
# nftables ruleset for fleetscale IPSec LVS nodes
#
# Drop any existing ruleset on load.
flush ruleset

# ── NAT table (DNAT in, SNAT out) ────────────────────────────────────────────
# Fully generated by ipsecpulse at boot and updated by ipsecscale on pool
# changes.  Contains PREROUTING (jhash DNAT) and POSTROUTING (SNAT) chains
# with all values hardcoded — no $VARIABLE references, no named maps with
# 'type integer', no elements blocks.  Avoids all nftables 1.0+ issues.
include "/etc/nftables.d/ipsec-nat.nft"

# ── Filter table ──────────────────────────────────────────────────────────────
table inet filter {

	# INPUT: packets destined for the LVS node itself.
	# Forwarded ESP/IKE never reaches INPUT — it is DNAT'd in PREROUTING and
	# then routed through FORWARD before the kernel delivers it locally.
	chain INPUT {
		type filter hook input priority filter; policy drop;

		# Loopback
		iifname "lo" accept

		# Established / related (replies to LVS-initiated connections,
		# e.g. AWS EC2 API calls and IMDS responses)
		ct state established,related accept
		ct state invalid drop

		# eth0 (data plane, public-facing):
		#   Allow ICMP for reachability probes.
		iifname "eth0" icmp type {
			echo-request,
			destination-unreachable,
			time-exceeded
		} accept
		# eth0 SSH: management fallback via the data-plane NIC.
		# AWS security groups restrict the source to CLI_RemoteAccess.
		# TODO: remove once a dedicated management bastion in the
		#       Management subnet (172.16.52.0/24) is operational.
		iifname "eth0" tcp dport 22 accept

		# eth1 (management, private subnet):
		#   SSH from the bastion + VRRP heartbeats from the peer LVS node.
		iifname "eth1" tcp dport 22 accept
		iifname "eth1" ip protocol 112 accept
		iifname "eth1" icmp type echo-request accept

		reject with icmp type admin-prohibited
	}

	# FORWARD: packets routed through this node.
	# All IPSec traffic is forwarded after DNAT; policy accept is correct here
	# because the security boundary is enforced by the SGs on the VPN nodes.
	chain FORWARD {
		type filter hook forward priority filter; policy accept;
	}
}
